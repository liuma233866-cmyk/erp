HOST=0.0.0.0
PORT=3000

# Required. Generate a unique value for every deployment with: openssl rand -hex 32
APP_SECRET_KEY=change-me-to-a-long-random-secret

# Optional: move runtime data and logs out of the app directory on servers.
DATA_DIR=./
LOG_DIR=./logs

# Allowed browser origins for ERP.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Optional bootstrap admin credentials used only when data.json is created from scratch.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# Optional external integrations.
OPENAI_API_KEY=
YANDEX_MARKET_BASE_URL=https://api.partner.market.yandex.ru
YANDEX_PROXY_URL=
# Optional HTTP CONNECT proxy for Ozon Seller API. If empty, HTTPS_PROXY and then YANDEX_PROXY_URL are used.
OZON_PROXY_URL=
TAMPERMONKEY_INGEST_KEY=

# Optional: MySQL storage for user management (GET/POST/PUT/DELETE /api/users*).
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=erp_app
MYSQL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# Preferred for production. The file must be readable only by the service account.
MYSQL_PASSWORD_FILE=
CENTRAL_CATALOG_ENABLED=1
MYSQL_DATABASE=
MYSQL_USER_TABLE=users
MYSQL_SHOP_TABLE=shops
MYSQL_PUBLISH_PRODUCT_TABLE=publish_products
MYSQL_ONLINE_PRODUCT_TABLE=online_products
MYSQL_ONLINE_PRODUCT_IMAGE_TABLE=online_product_images
MYSQL_PUBLISH_SETTINGS_TABLE=publish_settings
MYSQL_ORDER_TABLE=orders
MYSQL_ORDER_PURCHASE_TABLE=order_purchases
DISABLE_JSON_CHAIN_WHEN_MYSQL=1
MYSQL_YANDEX_COMMISSION_TABLE=yandex_commission_rates
MYSQL_OZON_CATEGORY_COMMISSION_TABLE=ozon_category_commissions
MYSQL_YANDEX_CATEGORY_COMMISSION_TABLE=yandex_category_commissions
# Optional: plugin category source table. Falls back to MYSQL_YANDEX_COMMISSION_TABLE when empty.
MYSQL_YANDEX_CATEGORY_TABLE=
# Optional: simple Ozon->Yandex category mapping table for the collector. Falls back to MYSQL_YANDEX_CATEGORY_TABLE when empty.
MYSQL_CATEGORY_MAPPING_TABLE=

# Optional runtime controls.
ORDER_SYNC_ENABLED=1
ORDER_SYNC_DAILY_TIME=06:00
CURRENCY_RATE_MAX_AGE_DAYS=3
YANDEX_ORDER_SYNC_LOOKBACK_DAYS=180
LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=600
# Set to 1 only when a trusted reverse proxy overwrites X-Forwarded-For; the
# server then uses the LAST forwarded entry. Without it, the raw socket address
# is used so clients cannot spoof an IP to bypass rate limits.
TRUST_PROXY=0
# PBKDF2-SHA512 iterations for password hashing (default 210000, OWASP 2023+).
# Existing hashes made with the old 100000 iterations still verify and are
# re-hashed transparently on next login.
PASSWORD_HASH_ITERATIONS=210000
# Maximum number of AI image tasks processed concurrently by one backend process (1-20).
AI_IMAGE_TASK_CONCURRENCY=3
